# Для просмотра готового сайта ключи API не нужны.
# Если будет добавлен поиск недостающих сайтов, используйте локальный .env:
# XMLRIVER_USER=
# XMLRIVER_KEY=
# Реальные ключи не коммитить. .env уже включён в .gitignore.
# Извлечение тарифов с официальных страниц:
DEEPSEEK_API_KEY=
# Необязательные резервные провайдеры:
DAHL_API_KEY=
IKHDEV_API_KEY=
